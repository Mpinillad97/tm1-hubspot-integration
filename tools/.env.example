# fetch_past_buyers.py configuration — copy to tools/.env and fill in your own values.
# PLACEHOLDERS ONLY. Never commit a file containing real credentials.
# The CSV this tool produces contains customer personal data: write it OUTSIDE
# the repository (e.g. --output ../../exports/past_buyers.csv) and handle it
# according to your data-protection obligations.

TM1_API_KEY=<tm1-api-key>
DISCOVERY_API_KEY=<discovery-api-key>
TM1_BASE_URL=https://app.ticketmaster.com/tm1-reports-api/v1
DISCOVERY_BASE_URL=https://app.ticketmaster.com/discovery/v2
