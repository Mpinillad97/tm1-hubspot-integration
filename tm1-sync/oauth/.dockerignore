# Build context for the OAuth service image:
#   docker build -t tm1-oauth .   (run from tm1-sync/oauth/)

# Secrets and local token storage — must never be baked into an image
.env
.env.*
*.env
tokens.json
*.pem
*.key

# Local environments, caches and build artifacts
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.log

# Not needed at runtime
Dockerfile
.dockerignore
.git/
