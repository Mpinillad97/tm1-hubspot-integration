# OAuth service configuration — copy to .env and fill in your own values.
# PLACEHOLDERS ONLY. Never commit a file containing real credentials.

# HubSpot OAuth app credentials (from your HubSpot developer project)
HUBSPOT_CLIENT_ID=<hubspot-oauth-client-id>
HUBSPOT_CLIENT_SECRET=<hubspot-oauth-client-secret>
# Must exactly match a redirect URL registered in TM1_Hubspot_data_sync/src/app/app-hsmeta.json
HUBSPOT_REDIRECT_URI=https://<your-oauth-service-host>/oauth/callback

# PostgreSQL connection string (same database as the sync job).
# If unset, tokens are written to a local tokens.json file (development only).
DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/<db_name>

# HTTP port (read by the Docker CMD; default 8080)
PORT=8080
