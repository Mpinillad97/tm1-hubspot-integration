# Sync job configuration — copy to .env and fill in your own values.
# PLACEHOLDERS ONLY. Never commit a file containing real credentials.
# Variables marked (required) make the job exit with an error if missing.

# --- Database ------------------------------------------------------------
# (required) PostgreSQL connection string
DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/<db_name>

# --- Tenant / runtime ----------------------------------------------------
# (required) Tenant identifier; scopes every DB row and the job lock name
CLIENT_ID=<tenant-id>
SYNC_ENABLED=true
# Loop interval when running without --once
SLEEP_SECONDS=300
# Initial cursor used when no sync_state row exists yet (ISO-8601, UTC)
DEFAULT_SINCE=2026-01-01T00:00:00Z

# --- Ticketmaster TM1 Reports API ---------------------------------------
# (required)
TM1_API_KEY=<tm1-api-key>
TM1_BASE_URL=https://app.ticketmaster.com/tm1-reports-api/v1
PAGE_SIZE=200
TM1_TIMEOUT_SECONDS=45
TM1_MAX_RETRIES=4

# --- Ticketmaster Discovery API -----------------------------------------
# (required)
DISCOVERY_API_KEY=<discovery-api-key>
DISCOVERY_BASE_URL=https://app.ticketmaster.com/discovery/v2
DISCOVERY_VIEW_INTERNAL=false
DISCOVERY_TIMEOUT_SECONDS=20
DISCOVERY_MAX_RETRIES=4
DISCOVERY_RPS_LIMIT=5
# Keep (runs per day x this value) below your daily Discovery quota
DISCOVERY_MAX_PER_RUN=50
EVENT_CACHE_TTL_HOURS=24

# --- HubSpot (OAuth app) -------------------------------------------------
# (required) HubSpot portal (hub) ID whose tokens were stored by the OAuth service
HUBSPOT_PORTAL_ID=<hubspot-portal-id>
# (required) OAuth app credentials, used to refresh access tokens
HUBSPOT_CLIENT_ID=<hubspot-oauth-client-id>
HUBSPOT_CLIENT_SECRET=<hubspot-oauth-client-secret>
HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_ORDER_OBJECT_TYPE=orders
# Fallback only; the job discovers the real association type ID at runtime
ORDERS_TO_CONTACTS_ASSOC_TYPE_ID=507
HUBSPOT_RATE_LIMIT_MAX=90
HUBSPOT_RATE_LIMIT_WINDOW_MS=10000

# --- Batch sizes ---------------------------------------------------------
NORMALIZE_BATCH_SIZE=2000
PUBLISH_BATCH_SIZE=100

# --- Logging -------------------------------------------------------------
# DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
# Fraction of per-item DEBUG events to emit (0.0 - 1.0)
LOG_ITEM_SAMPLE_RATE=0.10
# Max characters of HTTP response bodies included in error logs
LOG_HTTP_BODY_CHARS=700
LOG_INCLUDE_DEDUPE_KEYS=false
